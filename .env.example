# ==============================================================================
# AI Code Editor - Environment Configuration Template
# ==============================================================================
# Copy this file or service-specific .env.example templates to .env files
# in each respective folder and fill in your actual values.
# NEVER commit real .env files or credentials to Git!

# ------------------------------------------------------------------------------
# 1. API Gateway (backend/gateway/.env)
# ------------------------------------------------------------------------------
PORT=3000
AUTH_URL=http://localhost:3001
PROJECT_URL=http://localhost:3002
FILE_URL=http://localhost:3003
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 2. Auth Service (backend/services/auth/.env)
# ------------------------------------------------------------------------------
PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auth?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Firebase Admin SDK Credentials (Option A: Individual Variables)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Admin SDK Credentials (Option B: Path to local service account JSON file)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# 3. Project Service (backend/services/project/.env)
# ------------------------------------------------------------------------------
PORT=3002
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_super_secret_jwt_key_here

# ------------------------------------------------------------------------------
# 4. File Service (backend/services/file/.env)
# ------------------------------------------------------------------------------
PORT=3003
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/file?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. Frontend Client (frontend/.env)
# ------------------------------------------------------------------------------
VITE_SERVER_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
