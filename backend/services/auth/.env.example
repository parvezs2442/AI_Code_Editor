PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auth?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Firebase Admin Credentials (Option 1: Individual variables)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Admin Credentials (Option 2: Path to local JSON file)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
